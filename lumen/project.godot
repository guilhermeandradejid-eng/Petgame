; Engine configuration file.
; Lumen: roguelite cooperativo online em terceira pessoa.

config_version=5

[application]

config/name="Lumen"
config/description="Roguelite cooperativo online: explore as ruinas, monte seu visual e derrote o Guardiao com seus amigos."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://assets/icon.svg"

[autoload]

Save="*res://scripts/core/save.gd"
DB="*res://scripts/core/db.gd"
Net="*res://scripts/core/net.gd"
Game="*res://scripts/core/game.gd"
Fx="*res://scripts/core/fx.gd"
Sfx="*res://scripts/core/sfx.gd"
Dev="*res://scripts/core/dev.gd"

[debug]

gdscript/warnings/unused_parameter=0
gdscript/warnings/unused_variable=0
gdscript/warnings/unused_signal=0
gdscript/warnings/integer_division=0
gdscript/warnings/narrowing_conversion=0
gdscript/warnings/shadowed_variable=0
gdscript/warnings/shadowed_variable_base_class=0
gdscript/warnings/shadowed_global_identifier=0
gdscript/warnings/unused_private_class_variable=0
gdscript/warnings/static_called_on_instance=0

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[layer_names]

3d_physics/layer_1="mundo"
3d_physics/layer_2="jogadores"
3d_physics/layer_3="inimigos"

[physics]

common/physics_ticks_per_second=60
3d/default_gravity=24.0

[rendering]

anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/directional_shadow/size=4096
environment/defaults/default_clear_color=Color(0.08, 0.07, 0.13, 1)
