extends Node
## Tiny SFX player: pooled voices, pitch jitter, voice limiting. Sounds live in art/sfx/<id>.wav
## (generated by tools/sfxgen.py).

const POOL := 14
var _cache: Dictionary = {}
var _voices: Array[AudioStreamPlayer] = []
var _next := 0
var muted := false
var last_played: String = ""


func _ready() -> void:
	for i in POOL:
		var p := AudioStreamPlayer.new()
		p.bus = "Master"
		add_child(p)
		_voices.append(p)


func _stream(id: String) -> AudioStream:
	if _cache.has(id):
		return _cache[id]
	var path := "res://art/sfx/%s.wav" % id
	var s: AudioStream = null
	var r = load(path)
	if r is AudioStream:
		s = r
	else:
		var f := FileAccess.open(path, FileAccess.READ)
		if f != null:
			var bytes := f.get_buffer(f.get_length())
			var w := AudioStreamWAV.new()
			w.format = AudioStreamWAV.FORMAT_16_BITS
			w.mix_rate = 22050
			w.data = bytes.slice(44)
			s = w
	_cache[id] = s
	return s


func play(id: String, volume_db: float = 0.0, pitch: float = 1.0, jitter: float = 0.08) -> void:
	last_played = id
	Game.log_event("sfx", {"id": id})
	if muted:
		return
	var s := _stream(id)
	if s == null:
		return
	var v := _voices[_next]
	_next = (_next + 1) % POOL
	v.stream = s
	v.volume_db = volume_db
	v.pitch_scale = pitch * (1.0 + randf_range(-jitter, jitter))
	v.play()
