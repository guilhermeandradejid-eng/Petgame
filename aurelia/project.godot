; Engine configuration file.
config_version=5

[application]
config/name="Aurelia"
config/features=PackedStringArray("4.4", "GL Compatibility")
run/main_scene="res://ui/title.tscn"
config/icon="res://icon.svg"

[display]
window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[autoload]

InputRouter="*res://autoload/input_router.gd"
Game="*res://autoload/game.gd"
Registry="*res://autoload/registry.gd"
Sfx="*res://autoload/sfx.gd"
Juice="*res://autoload/juice.gd"
Net="*res://autoload/net.gd"

[physics]
common/physics_ticks_per_second=60
3d/default_gravity=24.0

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
anti_aliasing/quality/msaa_3d=0
environment/defaults/default_clear_color=Color(0.1, 0.12, 0.16, 1)
