; Céu Arcano — projeto Godot 4.5

config_version=5

[application]

config/name="Céu Arcano"
config/description="Duelo de cartas e magia no crepúsculo. Luta 2D em pixel art no estilo bullet-hell fighter."
run/main_scene="res://scenes/boot.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
boot_splash/bg_color=Color(0.043, 0.039, 0.141, 1)
boot_splash/show_image=false
config/icon="res://icon.svg"

[autoload]

Game="*res://scripts/core/game.gd"
Audio="*res://scripts/core/audio.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[input_devices]

pointing/emulate_touch_from_mouse=true

[physics]

common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=4

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.043, 0.039, 0.141, 1)
2d/snap/snap_2d_vertices_to_pixel=false
